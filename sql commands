// sql commands .

CREATE 

syntax : CREATE TABLE table_name (column1 data_type, column2 data_type);

EX:
CREATE TABLE Persons (
    PersonID int,
    LastName varchar(255),
    FirstName varchar(255),
    Address varchar(255),
    City varchar(255)
);


TRUNCATE

syntax : TRUNCATe TABLE table name ;

DROP
syntax : DROP TABLE table_name;

SELECT 

SYntax : SELECT col1,col2 from TABLE_name  WHERE condition ;

INSERT 

Syntax: INSERT INTO table_name (col1,col2...) VALUES (val1,val2..);


Joins in Sql :

INNERJOIN  :PROVIDES THE COMMON RECORDS FROM BOTH TABLES
LEFTJOIN   :PROVIDES ALL RECORDS FROM LEFT TABLE AND MATCHED RECORDS FROM RIGHTTABLE.
RIGHTJOIN  :PROVIDES ALL RECORDS FROMRIGHT TABLE AND MATCHED RECORDS FROM LEFT TABLE
FULLJOIN   :PROVIDES ALL THE RECORDS WHEN THERE IS MATCH IN EITHER LEFT OR RIGHT TABLE


